---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Button from '../components/Button.astro';
import Hero from '../sections/Hero.astro';
import Edges from '../sections/Edges.astro';
import Layers from '../sections/Layers.astro';
import Showcase from '../sections/Showcase.astro';
import Process from '../sections/Process.astro';
import Checks from '../sections/Checks.astro';
import Contact from '../sections/Contact.astro';
import Footer from '../sections/Footer.astro';

const links = [
  { label: 'Cómo funciona', href: '#bordes' },
  { label: 'Tokens', href: '#tokens' },
  { label: 'Componentes', href: '#componentes' },
  { label: 'Proceso', href: '#proceso' },
];
---

<Base title="DS-IA · Sistema de diseño spec-driven" description="Prueba de concepto: un contrato compartido entre Figma y código, sincronizado por agentes.">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-(--z-toast) focus:p-inset-sm focus:bg-surface-strong focus:text-link">Saltar al contenido</a>
  <Header links={links}>
    <Fragment slot="brand">
      <span class="size-icon-lg rounded-interactive bg-fill-primary text-on-brand inline-flex items-center justify-center text-label-3" aria-hidden="true">D</span>
      DS·IA
    </Fragment>
    <Button slot="actions" size="sm" href="#contacto">Conectar Figma</Button>
  </Header>
  <main id="main">
    <Hero />
    <Edges />
    <Layers />
    <Showcase />
    <Process />
    <Checks />
    <Contact />
  </main>
  <Footer />
</Base>
